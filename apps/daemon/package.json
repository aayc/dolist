{
  "name": "@ddl/daemon",
  "version": "0.1.0",
  "private": true,
  "description": "Local daemon: serves the UI, owns the vault (StorageProvider), and runs the always-on agent runtime. Binds to 127.0.0.1 only.",
  "type": "module",
  "bin": {
    "daily-do-list": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "bench": "vitest bench --run --reporter=default --reporter=json --outputFile.json=bench-results.json"
  },
  "dependencies": {
    "@ddl/agent": "workspace:*",
    "@ddl/connectors": "workspace:*",
    "@ddl/contract": "workspace:*",
    "@ddl/core": "workspace:*",
    "@ddl/storage": "workspace:*",
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "catalog:",
    "hono": "^4.13.8",
    "playwright-core": "catalog:",
    "typebox": "catalog:",
    "ws": "^8.21.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ddl/sync": "workspace:*",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
