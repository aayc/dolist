{
  "name": "@ddl/web",
  "version": "0.1.0",
  "private": true,
  "description": "Daily Do List UI (React + Vite). The same bundle ships in the web app and inside the future macOS/iOS shells.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test --project=functional",
    "e2e:perf": "playwright test --project=perf"
  },
  "dependencies": {
    "@ddl/core": "workspace:*",
    "@ddl/editor": "workspace:*",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@ddl/contract": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "vite": "^8.3.0"
  }
}
