{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "env": ["FC_SEED", "FC_NUM_RUNS", "TEST_TIME_SCALE"],
      "outputs": []
    },
    "bench": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": ["BENCH_BUDGET_MULTIPLIER"],
      "outputs": ["bench-results.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DDL_*", "OPENROUTER_API_KEY", "HOME"]
    }
  }
}
