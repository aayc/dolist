{
  "name": "@ddl/editor",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic CodeMirror 6 markdown editor with Obsidian-style live preview, task checkboxes, vim mode and agent annotation badges.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p test/vim/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "bench": "vitest bench --run --reporter=default --reporter=json --outputFile.json=bench-results.json",
    "vim:vectors": "tsx test/vim/scripts/vectors.ts",
    "vim:check": "tsx test/vim/scripts/check.ts",
    "vim:upstream": "tsx test/vim/scripts/upstream.ts",
    "vim:replay": "tsx test/vim/scripts/replay.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@ddl/core": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@replit/codemirror-vim": "^6.4.0"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-xml": "^6.1.0",
    "@replit/codemirror-vim-core": "0.1.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "playwright-core": "catalog:",
    "tsx": "^4.23.15"
  }
}
