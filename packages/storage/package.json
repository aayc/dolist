{
  "name": "@ddl/storage",
  "version": "0.1.0",
  "private": true,
  "description": "Vault storage behind a Provider interface (local filesystem today, S3 next) plus a provider-agnostic sync engine.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./contract-suite": "./src/contract-suite.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "bench": "vitest bench --run --reporter=default --reporter=json --outputFile.json=bench-results.json"
  },
  "dependencies": {
    "@ddl/core": "workspace:*"
  },
  "devDependencies": {
    "@ddl/sync": "workspace:*",
    "vitest": "^5.0.1"
  }
}
