{
  "name": "@ddl/agent",
  "version": "0.1.0",
  "private": true,
  "description": "The always-on agent system: note watcher, orchestrator, subagents (Pi or Cursor CLI harness), safety evaluator + approvals, execution providers, threads and artifacts.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./pi": "./src/harness/pi.ts",
    "./cursor": "./src/harness/cursor.ts",
    "./journal": "./src/threads/journal/index.ts",
    "./routines": "./src/routines/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "fake-openrouter": "tsx scripts/fake-openrouter.ts",
    "dev:fake": "tsx scripts/dev-fake.ts",
    "dev:mock": "tsx scripts/dev-mock.ts"
  },
  "dependencies": {
    "@ddl/connectors": "workspace:*",
    "@ddl/contract": "workspace:*",
    "@ddl/core": "workspace:*",
    "@ddl/storage": "workspace:*",
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "playwright-core": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "catalog:",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
