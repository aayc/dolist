# Copy to ~/.daily-do-list/.env (preferred — lives outside the repo) or ./.env.local (gitignored).
# Never commit real values. This file is the only env file that is tracked.

# Required for real agent runs (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional overrides
# DDL_HOME=~/.daily-do-list            # app state, token, config, workspaces, browser profile
# DDL_VAULT=~/DailyDoList              # markdown vault root (point at an Obsidian vault to reuse it)
# DDL_PORT=7331                        # daemon port (binds 127.0.0.1 only)
# DDL_MODEL=deepseek/deepseek-v4.1-flash
# DDL_AGENT_MODE=live                  # live | mock | off
