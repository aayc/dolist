#!/bin/sh
# Versioned pre-commit hook (installed via `pnpm install` → scripts/install-git-hooks.mjs).
# This repository is PUBLIC: never bypass with --no-verify for anything touching config or secrets.
set -e
# Optional, per clone: `git config ddl.requiredEmail <email>` refuses commits under any other identity
# (a work address from the global config or GIT_AUTHOR_EMAIL, say). Stored in .git/config only.
required=$(git config --get ddl.requiredEmail || true)
if [ -n "$required" ]; then
  for ident in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
    email=$(git var "$ident" | sed -n 's/^.*<\(.*\)>.*$/\1/p')
    if [ "$email" != "$required" ]; then
      echo "✖ $ident is <$email>, but this clone commits only as <$required> (git config ddl.requiredEmail)." >&2
      exit 1
    fi
  done
fi
node scripts/check-secrets.mjs --staged
# A second, independent scanner (`brew install gitleaks`). The pre-push hook and CI require it.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --config .gitleaks.toml --redact --no-banner --log-level warn -v .
else
  echo "⚠ gitleaks is not installed (brew install gitleaks); the pre-push hook needs it." >&2
fi
# Hygiene, Biome, shellcheck, actionlint and the Swift vectors, for what's staged.
node scripts/lint.mjs --staged
