{
  "name": "daily-do-list",
  "version": "0.1.0",
  "private": true,
  "description": "Daily Do List \u2014 a local-first markdown notes app where an always-on AI orchestrator watches your daily to-do list and actually does the tasks.",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.4.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@ddl/daemon --filter=@ddl/web",
    "dev:mock": "pnpm --filter @ddl/agent dev:mock",
    "dev:fake": "pnpm --filter @ddl/agent dev:fake",
    "build": "turbo run build",
    "start": "pnpm --filter @ddl/daemon start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "node scripts/lint.mjs --all",
    "lint:fix": "node scripts/lint.mjs --all --fix",
    "format": "biome format --write .",
    "bench": "turbo run bench",
    "bench:check": "node scripts/bench-check.mjs",
    "size:check": "node scripts/bundle-size-check.mjs",
    "e2e": "pnpm --filter @ddl/web e2e",
    "e2e:perf": "pnpm --filter @ddl/web e2e:perf",
    "eval": "pnpm --filter @ddl/evals eval",
    "eval:mock": "pnpm --filter @ddl/evals eval:mock",
    "vim:vectors": "pnpm --filter @ddl/editor vim:vectors",
    "vim:check": "pnpm --filter @ddl/editor vim:check",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "vectors": "tsx apps/macos/scripts/generate-vectors.ts",
    "vectors:check": "tsx apps/macos/scripts/generate-vectors.ts --check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:secrets",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@fast-check/vitest": "^0.5.0",
    "@types/node": "^24.0.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
